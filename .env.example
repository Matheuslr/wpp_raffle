NODE_ENV=production
RUN_WHATSAPP_GATEWAY=true

# Local note for the WhatsApp account linked through Baileys.
WHATSAPP_PHONE_NUMBER=5500000000000

# Comma-separated authorized WhatsApp group IDs. Use exactly one group for the MVP.
AUTHORIZED_GROUP_IDS=120363000000000000@g.us

# Container paths used by compose.prod.yml volume mounts.
BAILEYS_AUTH_DIR=/app/runtime/auth
DRAW_HISTORY_FILE=/app/runtime/data/draw-history.json

# Keep false in production. This exists only for single-account local testing.
ALLOW_OWN_MESSAGES_FOR_LOCAL_TESTING=false
